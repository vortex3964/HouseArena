{
  "expo": {
    "name": "HouseArena",
    "slug": "HouseArena",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/appImages/logo.png",
    "scheme": "housearena",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "HouseArena needs photo library access so you can set a profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0A18",
        "foregroundImage": "./assets/images/appImages/logo.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/appImages/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0A18",
          "image": "./assets/images/appImages/logo.png",
          "imageWidth": 128
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
